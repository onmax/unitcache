{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@units/admin/*": [
        "./src/units/admin/*"
      ],
      "@units/settings/*": [
        "./src/units/settings/*"
      ]
    }
  },
  "include": [
    "src",
    "packages/*/src",
    "units.ts",
    "vite.config.ts"
  ]
}
